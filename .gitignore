# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Environment variables / secrets
.env
.env.*
!.env.example

# Pretrained / downloaded AI models
pretrained_models/
models/
*.bin
*.safetensors
*.pt
*.pth
*.ckpt

# Trusted voice identities
trusted_identities/

# Uploaded / temporary audio
uploads/
temp/
tmp/
*.wav
*.mp3
*.m4a
*.webm
*.ogg
*.flac

# AIA generated history / security data
history/
results/
alerts.json
security_events.json

# Next.js
frontend/node_modules/
frontend/.next/
frontend/out/

# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
frontend/.env.local
backend/.env

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Misc temporary files
*.tmp
*.temp

# AIA local/generated data
analysis_history.json
privacy_settings.json